          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validate Transaction Network and Content Context\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type matches JSON API schema specs\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// 2. Validate Successful Success Envelope Boundaries\r",
              "pm.test(\"Response status confirms successful resolution\", function () {\r",
              "    pm.expect(jsonData.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"Headlines object resolves to an active array wrapper\", function () {\r",
              "    pm.expect(jsonData.articles).to.be.an('array');\r",
              "    pm.expect(jsonData.totalResults).to.be.a('number');\r",
              "    pm.expect(jsonData.totalResults).to.be.at.least(0);\r",
              "});\r",
              "\r",
              "// 3. Verify Inner Record Field Layouts Without Hardcoding Brittle Counts\r",
              "pm.test(\"Articles data nodes match contract property structure\", function () {\r",
              "    if (jsonData.articles.length > 0) {\r",
              "        const standardArticle = jsonData.articles[0];\r",
              "        pm.expect(standardArticle).to.have.property('title');\r",
              "        pm.expect(standardArticle).to.have.property('url');\r",
              "        pm.expect(standardArticle).to.have.property('publishedAt');\r",
              "    }\r",
              "});\r",
              "\r",
              "// 4. Track System Performance Metrics\r",
              "pm.test(\"Response latency operates within accepted team assumptions\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
