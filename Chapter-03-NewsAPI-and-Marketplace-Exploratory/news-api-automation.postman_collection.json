  "item": [
    {
      "name": "TC-NEWS-01: Search articles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. HTTP Status & Content-Type Validation\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is JSON format\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// 2. Response Envelope Validation\r",
              "pm.test(\"Root status field equals 'ok'\", function () {\r",
              "    pm.expect(jsonData.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"Articles structure is an array and totalResults is non-negative\", function () {\r",
              "    pm.expect(jsonData.articles).to.be.an('array');\r",
              "    pm.expect(jsonData.totalResults).to.be.a('number');\r",
              "    pm.expect(jsonData.totalResults).to.be.at.least(0);\r",
              "});\r",
              "\r",
              "// 3. Representative Fields Validation (Resilient to live data changes)\r",
              "pm.test(\"Representative item fields are present inside the articles array\", function () {\r",
              "    if (jsonData.articles.length > 0) {\r",
              "        // Evaluate the schema properties of the first element in the dynamic array\r",
              "        const standardArticle = jsonData.articles[0];\r",
              "        pm.expect(standardArticle).to.have.property('title');\r",
              "        pm.expect(standardArticle).to.have.property('url');\r",
              "        pm.expect(standardArticle).to.have.property('publishedAt');\r",
              "    }\r",
              "});\r",
              "\r",
              "// 4. Performance Metrics Observation (Labelled as an environment assumption profile)\r",
              "pm.test(\"Response latency is within acceptable range\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://newsapi.org/v2/everything?q=technology",
          "protocol": "https",
          "host": [
            "newsapi",
            "org"
          ],
          "path": [
            "v2",
            "everything"
          ],
          "query": [
            {
              "key": "q",
              "value": "technology"
            }
          ]
        }
      },
      "response": []
    },
